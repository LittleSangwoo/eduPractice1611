<Window x:Class="SweetCraft.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="680" Width="860" MinHeight="500" MinWidth="700"
        Icon="{StaticResource BakeryIcon}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Личный кабинет" FontSize="25" FontWeight="Bold" Margin="0,0,0,12" />
        <GroupBox Grid.Row="1" Header="Ваши данные" Padding="12" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="Фамилия"/><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="Имя"/><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="Отчество"/><TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4"><TextBlock Text="Email"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="Телефон"/><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4"><TextBlock Text="Роль (изменяется администратором)"/><TextBox Text="{Binding RoleName, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="История заказов" Padding="8"><DataGrid ItemsSource="{Binding OrderHistory}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="*"/><DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=g}" Width="*"/><DataGridTextColumn Header="Готовность" Binding="{Binding ReadyAt, StringFormat=g}" Width="*"/><DataGridTextColumn Header="Статус" Binding="{Binding OrderStatuses.Name}" Width="*"/><DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid></GroupBox>
        <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Сохранить профиль" Command="{Binding SaveCommand}"/><Button DockPanel.Dock="Right" Content="Выйти из аккаунта" Click="LogoutButton_Click"/></DockPanel>
    </Grid>
</Window>
