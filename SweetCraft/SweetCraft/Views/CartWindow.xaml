<Window x:Class="SweetCraft.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина и предзаказ" Height="690" Width="900" MinHeight="520" MinWidth="700"
        Icon="{StaticResource BakeryIcon}" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,14">
            <DataGrid.Columns><DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="Начинка" Binding="{Binding FillingName}" Width="*"/><DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat=N2}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"><Button Content="−" Command="{Binding DecreaseCommand}"/><Button Content="+" Command="{Binding IncreaseCommand}"/><Button Content="Удалить" Command="{Binding RemoveCommand}"/></StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=Итого: {0:N2} ₽}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
        <GroupBox Grid.Row="2" Header="Оформление предзаказа" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="Дата готовности"/><DatePicker SelectedDate="{Binding ReadyAt}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="Телефон для связи"/><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="Адрес доставки"/><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4"><TextBlock Text="Доставка"/><ComboBox ItemsSource="{Binding DeliveryMethods}" DisplayMemberPath="Name" SelectedValuePath="DeliveryMethodId" SelectedValue="{Binding SelectedDeliveryId}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="Оплата"/><ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Name" SelectedValuePath="PaymentMethodId" SelectedValue="{Binding SelectedPaymentId}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4"><TextBlock Text="Комментарий к заказу"/><TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" /></StackPanel>
            </Grid>
        </GroupBox>
        <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Content="Оформить предзаказ" Command="{Binding PlaceOrderCommand}" /></DockPanel>
    </Grid>
</Window>
