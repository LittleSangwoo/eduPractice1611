<Window x:Class="SweetCraft.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SweetCraft — каталог" Height="760" Width="1120" MinHeight="560" MinWidth="760"
        Icon="{StaticResource BakeryIcon}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Корзина" Click="CartButton_Click" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Личный кабинет" Click="ProfileButton_Click" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Управление БД" Click="AdminButton_Click" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="48" Height="48" Margin="0,0,12,0"><Canvas Width="48" Height="48"><Ellipse Width="44" Height="44" Canvas.Left="2" Canvas.Top="2" Fill="#9B4F35"/><Path Data="M 11,29 C 14,17 34,17 37,29 L 37,34 L 11,34 Z" Fill="#FFF7EE"/><Path Data="M 12,25 C 16,13 31,13 36,25 C 31,22 17,22 12,25 Z" Fill="#E9A64D"/><Ellipse Width="5" Height="5" Canvas.Left="14" Canvas.Top="13" Fill="#FFF7EE"/><Ellipse Width="5" Height="5" Canvas.Left="22" Canvas.Top="9" Fill="#FFF7EE"/><Ellipse Width="5" Height="5" Canvas.Left="30" Canvas.Top="13" Fill="#FFF7EE"/></Canvas></Viewbox>
                <StackPanel><TextBlock Text="SweetCraft" FontSize="25" FontWeight="Bold"/><TextBlock Text="Свежая выпечка и торты на заказ" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" />
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0" MaxLength="120" ToolTip="Поиск по названию и описанию" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="CategoryId" SelectedValue="{Binding SelectedCategoryId}" ToolTip="Категория" />
                <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Fillings}" DisplayMemberPath="Name" SelectedValuePath="FillingId" SelectedValue="{Binding SelectedFillingId}" ToolTip="Начинка" />
                <ComboBox Grid.Column="3" Margin="0,0,8,0" SelectedValuePath="Content" SelectedValue="{Binding SelectedSort}"><ComboBoxItem Content="По названию"/><ComboBoxItem Content="Цена по возрастанию"/><ComboBoxItem Content="Цена по убыванию"/></ComboBox>
                <Button Grid.Column="4" Content="Обновить" Command="{Binding RefreshCommand}" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{Binding Products}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" MinHeight="330" Margin="0,0,14,14" Padding="14" CornerRadius="12" Background="{Binding CardBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="#FFF1E4" CornerRadius="8"><Image Source="{Binding ImagePath}" Stretch="UniformToFill" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,10,0,4" Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding PremiumLabel}" Foreground="#9B4F35" FontWeight="Bold" Margin="10,3,0,0"/></StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MaxHeight="60" />
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
                                    <TextBlock Text="{Binding PreviousPrice, StringFormat={}{0:N2} ₽}" TextDecorations="Strikethrough" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:N2} ₽}" FontSize="18" FontWeight="{Binding PriceWeight}" />
                                </StackPanel>
                                <Button Grid.Row="4" Content="В корзину" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
