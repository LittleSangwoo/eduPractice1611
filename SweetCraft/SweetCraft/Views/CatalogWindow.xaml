<Window x:Class="SweetCraft.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SweetCraft — каталог" Height="800" Width="1280" MinHeight="600" MinWidth="900"
        Icon="{StaticResource BakeryIcon}" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="0,8,8,0" Padding="18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="4,12,4,0"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,8,4,24">
                        <Viewbox Width="42" Height="42" Margin="0,0,10,0">
                            <Canvas Width="48" Height="48">
                                <Ellipse Width="44" Height="44" Canvas.Left="2" Canvas.Top="2" Fill="#FFE56B73"/>
                                <Path Data="M 11,29 C 14,17 34,17 37,29 L 37,34 L 11,34 Z" Fill="#FFFFF7E6"/>
                                <Path Data="M 12,25 C 16,13 31,13 36,25 C 31,22 17,22 12,25 Z" Fill="#FFF9A826"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="14" Canvas.Top="13" Fill="#FFFFF7E6"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="22" Canvas.Top="9" Fill="#FFFFF7E6"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="30" Canvas.Top="13" Fill="#FFFFF7E6"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SweetCraft" FontFamily="{StaticResource MontserratFont}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Пекарня с душой" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="МЕНЮ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,6"/>
                    <Border Background="#FFFFF0F1" CornerRadius="6" Padding="14,11" Margin="4,3"><TextBlock Text="Каталог товаров" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></Border>
                    <Button Content="Корзина" Style="{StaticResource SidebarButtonStyle}" Click="CartButton_Click" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Личный кабинет" Style="{StaticResource SidebarButtonStyle}" Click="ProfileButton_Click" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Управление базой" Style="{StaticResource SidebarButtonStyle}" Click="AdminButton_Click" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Войти" Style="{StaticResource SidebarButtonStyle}" Click="LoginButton_Click" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="28,24,28,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="Свежая выпечка для тёплых моментов" Style="{StaticResource PageTitleStyle}" FontSize="26"/>
                <TextBlock Text="Выберите любимое лакомство или найдите что-то новое" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,18" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Поиск" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <Grid>
                            <TextBox MaxLength="120" ToolTip="Поиск по названию и описанию" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="поиск..." Foreground="{StaticResource MutedBrush}" Margin="11,8,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Категория" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="CategoryId" SelectedValue="{Binding SelectedCategoryId}" ToolTip="Категория" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Начинка" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Fillings}" DisplayMemberPath="Name" SelectedValuePath="FillingId" SelectedValue="{Binding SelectedFillingId}" ToolTip="Начинка" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Сортировка" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedSort}"><ComboBoxItem Content="По названию"/><ComboBoxItem Content="Цена по возрастанию"/><ComboBoxItem Content="Цена по убыванию"/></ComboBox>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="4" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" />
                    <Button Grid.Row="1" Grid.Column="5" Content="Сбросить фильтры" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <ListView ItemsSource="{Binding Products}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" MinHeight="420" Margin="0,0,18,18" Padding="0" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Effect="{StaticResource CardShadowEffect}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="8,8,0,0" ClipToBounds="True" Background="{StaticResource PremiumBackgroundBrush}">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="9,5" CornerRadius="6" Background="{StaticResource AccentLightBrush}" Effect="{StaticResource PremiumShadowEffect}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPremium}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="★ ПРЕМИУМ" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46" Margin="14,12,14,2"/>
                                <TextBlock Grid.Row="2" Text="{Binding FillingNames}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="14,2,14,6"/>
                                <TextBlock Grid.Row="3" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MaxHeight="54" Margin="14,4,14,8"/>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,6,14,8">
                                    <TextBlock Text="{Binding PreviousPrice, StringFormat={}{0:N2} ₽}" TextDecorations="Strikethrough" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:N2} ₽}" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                <Grid Grid.Row="5" Margin="10,0,10,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Подробнее" Style="{StaticResource SecondaryButtonStyle}" Click="ProductDetailsButton_Click" CommandParameter="{Binding}"/>
                                    <Button Grid.Column="1" Content="В корзину" Style="{StaticResource SuccessButtonStyle}" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
